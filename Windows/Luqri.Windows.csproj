<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>Luqri</AssemblyName>
    <RootNamespace>Luqri</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF creates windows before the WinForms tray, so DPI awareness is set at launch. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>Luqri.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.0" />
    <Resource Include="Icons\*.svg" />
    <EmbeddedResource Include="Luqri.ico" />
    <None Update="Lucide-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
